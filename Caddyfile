{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.napkin.academy https://*.supabase.co wss://*.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://*.googleusercontent.com; object-src 'none'; script-src 'self'; style-src 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	@private path /login /auth/callback /home /practice
	header @private X-Robots-Tag "noindex, nofollow"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@app path / /login /auth/callback /home /practice
	handle @app {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle /health {
		respond "OK" 200
	}

	handle {
		file_server
	}
}
